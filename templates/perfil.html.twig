{% extends "base.html.twig" %}

{% block title %}{{ titulo_pagina }}{% endblock %}

{% block content %}
    <section class="container perfil-pagina">
        {# La cabecera reúne el avatar y el nombre del usuario conectado. #}
        <header class="perfil-cabecera">
            {% if usuario.foto %}
                <img class="avatar perfil-avatar" src="{{ usuario.foto }}" alt="Tu foto de perfil">
            {% endif %}
            <div>
                <p class="perfil-presentacion">Tu perfil</p>
                <h2>{{ usuario.nombre }} {{ usuario.apellidos }}</h2>
                <span class="estado">{{ usuario.rol == 'ADMIN' ? 'Administrador' : 'Profesional' }}</span>
            </div>
        </header>

        <section class="perfil-datos" aria-labelledby="titulo-datos">
            <h3 id="titulo-datos">Datos personales</h3>
            <dl class="datos-perfil">
                <div>
                    <dt>Email</dt>
                    <dd>{{ usuario.email }}</dd>
                </div>
                <div>
                    <dt>Teléfono</dt>
                    <dd>{{ usuario.telefono ?: 'No indicado' }}</dd>
                </div>
                <div>
                    <dt>Saldo</dt>
                    <dd><span class="puntos">{{ usuario.puntosSaldo }} puntos</span></dd>
                </div>
                <div>
                    <dt>Miembro desde</dt>
                    <dd>{{ usuario.fechaRegistro|date('d/m/Y') }}</dd>
                </div>
                {% if usuario.curriculum %}
                    <div class="dato-curriculum">
                        <dt>Currículum</dt>
                        <dd><a class="enlace-boton secundario" href="{{ usuario.curriculum }}" target="_blank" rel="noopener">Ver currículum</a></dd>
                    </div>
                {% endif %}
            </dl>
        </section>

        {% if usuario.rol == 'PROFESIONAL' %}
            <section id="resenas" data-profesional="{{ usuario.id }}" aria-labelledby="titulo-resenas">
                <h3 id="titulo-resenas">Mis reseñas</h3>
                <div id="resumen-resenas"></div>
                <div id="lista-resenas"><p>Cargando…</p></div>
            </section>
        {% endif %}

    </section>
{% endblock %}

{% block javascript %}
    <script type="module" src="/js/resenas.js"></script>
{% endblock %}