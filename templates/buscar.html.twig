{% extends "base.html.twig" %}

{% block title %}{{ titulo_pagina }}{% endblock %}

{% block content %}
    <section class="container buscador" id="app-buscar"
             data-usuario-id="{{ usuario ? usuario.id : '' }}"
             data-rol="{{ usuario ? usuario.rol : '' }}">
        <h2>Buscar servicio</h2>
        <p>Encuentra a un profesional y paga con tus puntos. Cada profesional fija cuántos puntos cobra por hora.</p>

        <p id="mensaje" role="status" aria-live="polite" hidden></p>

        <form id="form-filtros" class="filtros" role="search" novalidate>
            <div>
                <label for="q">¿Qué necesitas?</label>
                <input type="search" id="q" name="q" maxlength="100" placeholder="Fontanería, ordenadores…">
            </div>
            <div>
                <label for="id_categoria">Categoría</label>
                <select id="id_categoria" name="id_categoria">
                    <option value="">Todas</option>
                </select>
            </div>
            <button type="submit">Buscar</button>
        </form>

        <div id="app-ofertas" aria-live="polite"></div>
    </section>

    {% if usuario and usuario.rol == 'PROFESIONAL' %}
        <dialog id="dialogo-solicitud" aria-labelledby="dialogo-titulo">
            <form id="form-solicitud" novalidate>
                <h3 id="dialogo-titulo">Solicitar servicio</h3>

                <p id="dialogo-resumen"></p>
                <p id="dialogo-mensaje" role="alert" hidden></p>

                <input type="hidden" id="id_oferta">

                <div>
                    <p class="etiqueta">Duración estimada</p>
                    <div class="duracion-estimada">
                        <div>
                            <label for="duracion-horas">Horas</label>
                            <select id="duracion-horas">
                                {% for hora in 0..24 %}
                                    <option value="{{ hora }}" {% if hora == 1 %}selected{% endif %}>{{ hora }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="duracion-minutos">Minutos</label>
                            <select id="duracion-minutos">
                                <option value="0" selected>00</option>
                                <option value="30">30</option>
                            </select>
                        </div>
                    </div>
                    <p class="ayuda">Elige una duración de 30 minutos a 24 horas, en intervalos de media hora.</p>
                </div>
                <div>
                    <label for="fecha_propuesta">Fecha y hora que propones</label>
                    <input type="datetime-local" id="fecha_propuesta" required>
                </div>

                <p>Coste: <span class="puntos" id="dialogo-total">0</span> puntos · Disponibles tras reservar solicitudes: <strong id="dialogo-saldo"></strong></p>

                <div class="acciones">
                    <button type="submit" id="btn-enviar-solicitud">Enviar solicitud</button>
                    <button type="button" id="btn-cerrar-dialogo">Cancelar</button>
                </div>
            </form>
        </dialog>
    {% endif %}
{% endblock %}

{% block javascript %}
    <script type="module" src="/js/buscar.js?v=20261121-2"></script>
{% endblock %}
