{% extends "base.html.twig" %}

{% block title %}{{ titulo_pagina }}{% endblock %}

{% block body_class %}pagina-login pagina-registro{% endblock %}

{% block content %}
    <section class="container">
        <h2>Crear cuenta</h2>

        <p id="mensaje" role="alert" hidden></p>

        <form id="form-registro" novalidate>
            <div>
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" maxlength="100" autocomplete="given-name" required>
            </div>
            <div>
                <label for="apellidos">Apellidos</label>
                <input type="text" id="apellidos" name="apellidos" maxlength="100" autocomplete="family-name" required>
            </div>
            <div>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" maxlength="150" autocomplete="username" required>
            </div>
            <div>
                <label for="telefono">Teléfono (opcional)</label>
                <input type="tel" id="telefono" name="telefono" maxlength="20" autocomplete="tel">
            </div>
            <div>
                <label for="password">Contraseña (mínimo 8 caracteres)</label>
                <input type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required>
            </div>
            <div>
                <label for="password2">Repite la contraseña</label>
                <input type="password" id="password2" name="password2" maxlength="72" autocomplete="new-password" required>
            </div>

            <fieldset class="selector-servicios">
                <legend>Servicios que ofreces <span class="ayuda">(opcional)</span></legend>
                <p class="ayuda">Elige una categoría y pulsa los servicios que sabes hacer: se añadirán a tu lista. Los ofrecerás desde el primer día con la tarifa de referencia.</p>

                <div class="selector-columnas">
                    <div class="selector-columna">
                        <p class="selector-titulo" id="titulo-categorias">Categorías</p>
                        <ul class="selector-lista" id="lista-categorias" aria-labelledby="titulo-categorias">
                            <li class="selector-vacio">Cargando…</li>
                        </ul>
                    </div>
                    <div class="selector-columna">
                        <p class="selector-titulo" id="titulo-servicios">Servicios</p>
                        <ul class="selector-lista" id="lista-servicios" aria-labelledby="titulo-servicios">
                            <li class="selector-vacio">Elige una categoría</li>
                        </ul>
                    </div>
                    <div class="selector-columna">
                        <p class="selector-titulo" id="titulo-seleccion">Servicios seleccionados</p>
                        <ul class="selector-lista" id="lista-seleccion" aria-labelledby="titulo-seleccion" aria-live="polite">
                            <li class="selector-vacio">Todavía no has elegido ninguno</li>
                        </ul>
                    </div>
                </div>
            </fieldset>

            <div>
                <label for="foto">Foto de perfil (opcional)</label>
                <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp">
                <p class="ayuda">JPG, PNG o WEBP, hasta 2 MB.</p>
            </div>

            <button type="submit" id="btn-registrar">Crear cuenta</button>
        </form>

        <p class="aviso-alterno">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </section>
{% endblock %}

{% block javascript %}
    <script type="module" src="/js/registro.js"></script>
{% endblock %}
