<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Banco de Horas y Servicios{% endblock %}</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="{% block body_class %}{% endblock %}">
    {# Menú principal: los enlaces cambian según haya sesión y según el rol. #}
    {% set enlaces = [
        {href: '/', texto: 'Inicio'},
        {href: '/buscar', texto: 'Buscar servicio'}
    ] %}
    {% if usuario and usuario.rol == 'ADMIN' %}
        {% set enlaces = enlaces|merge([{href: '/servicios-spa', texto: 'Catálogo'}]) %}
    {% elseif usuario %}
        {% set enlaces = enlaces|merge([{href: '/solicitudes', texto: 'Mis solicitudes'}]) %}
    {% else %}
        {% set enlaces = enlaces|merge([
            {href: '/login', texto: 'Iniciar sesión'},
            {href: '/registro', texto: 'Registrarse', clase: 'enlace-destacado'}
        ]) %}
    {% endif %}

    <header>
        <h1><a href="/">Banco de Horas</a></h1>

        <nav class="principal" aria-label="Principal">
            {% for enlace in enlaces %}
                <a href="{{ enlace.href }}"
                   {% if enlace.clase is defined %}class="{{ enlace.clase }}"{% endif %}
                   {% if ruta_actual == enlace.href %}aria-current="page"{% endif %}>{{ enlace.texto }}</a>
            {% endfor %}
        </nav>

        {% if usuario %}
            <div class="cuenta">
                <span class="usuario">{{ usuario.nombre }}</span>
                <span class="saldo-pill" title="Tu saldo de puntos"><strong>{{ usuario.puntosSaldo }}</strong> puntos</span>
                <button type="button" id="btn-logout">Cerrar sesión</button>
            </div>
        {% endif %}
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <script type="module" src="/js/layout.js"></script>
    {% block javascript %}{% endblock %}
</body>
</html>
